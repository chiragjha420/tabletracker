# JBB TableTracker Environment Configuration

# Public Supabase URL (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Base URL (for QR code resolution and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
